{
  "permissions": {
    "allow": [
      "Bash(node --check:*)",
      "Bash(node --test:*)",
      "Bash(bash .claude/hooks/verify.sh)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.sh\"",
            "timeout": 60,
            "statusMessage": "Verifying"
          }
        ]
      }
    ]
  }
}
